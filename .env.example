# Flask Configuration
SECRET_KEY=anti-matrix-production-secret-key-super-secure-2026
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5050

# Database Configuration
# Local Development (SQLite):
DATABASE_URL=sqlite:///antimatrix.db
# Supabase / Production PostgreSQL on Render:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase API (Optional Client / Storage)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=[YOUR-SUPABASE-ANON-OR-SERVICE-KEY]

# Video & Document Storage
UPLOAD_FOLDER=app/static/uploads
VIDEO_UPLOAD_FOLDER=instance/uploads/videos
MAX_VIDEO_SIZE_MB=100
MAX_CONTENT_LENGTH=125829120

# Base Domain
BASE_URL=http://localhost:5050
