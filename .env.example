# Flask Configuration
SECRET_KEY=anti-matrix-production-secret-key-super-secure-2026
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Database Configuration (SQLite default, PostgreSQL in production)
DATABASE_URL=sqlite:///antimatrix.db

# Storage
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=16777216 # 16 MB

# Mail Configuration (Optional SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@antimatrix.tech

# Base Domain
BASE_URL=http://localhost:5000
